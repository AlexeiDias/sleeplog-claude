rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Staff-side access to a daycare's data.
    //
    // The role check is load-bearing, not decorative. Parent accounts also
    // carry a daycareId (copied from their invite), so a daycareId-only check
    // would let any parent read AND WRITE every child's logs in the daycare.
    // Parents are scoped by familyId via isParentOfChild() instead.
    function belongsToDaycare(daycareId) {
      return isAuthenticated()
             && getUserData().daycareId == daycareId
             && getUserData().role in ['admin', 'staff'];
    }

    function isAdminOfDaycare(daycareId) {
      return isAuthenticated() && getUserData().daycareId == daycareId && getUserData().role == 'admin';
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function getChildDaycareId(childId) {
      return get(/databases/$(database)/documents/children/$(childId)).data.daycareId;
    }

    // --- PARENTS PORTAL HELPERS ---

    // The signed-in user's email, lowercased, or '' when absent.
    // Parent invites are keyed by lowercased email.
    function authEmail() {
      return isAuthenticated() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    // An invite may be redeemed while pending, or re-redeemed by the same
    // account that already accepted it (e.g. their user document was deleted
    // and recreated). A 'revoked' invite is never usable — this is what makes
    // admin revocation stick.
    function inviteUsable(inviteId) {
      return get(/databases/$(database)/documents/parentInvites/$(inviteId)).data.status == 'pending'
             || (get(/databases/$(database)/documents/parentInvites/$(inviteId)).data.status == 'accepted'
                 && get(/databases/$(database)/documents/parentInvites/$(inviteId)).data.acceptedBy == request.auth.uid);
    }

    // True only for a parent whose own familyId matches the child's familyId.
    // This is what scopes a parent to their own children rather than to the
    // whole daycare — parents must never be granted access via daycareId.
    function isParentOfChild(childId) {
      return isAuthenticated() &&
             getUserData().role == 'parent' &&
             getUserData().familyId == get(/databases/$(database)/documents/children/$(childId)).data.familyId;
    }

    // ============================================
    // DAYCARES
    // ============================================
    match /daycares/{daycareId} {
      // Any authenticated user can read (kiosk setup, registration, reports)
      allow read: if isAuthenticated();

      // Only the daycare admin can update
      allow update: if isAdminOfDaycare(daycareId);

      // Authenticated users can create (registration flow)
      allow create: if isAuthenticated();

      // Only admin can delete
      allow delete: if isAdminOfDaycare(daycareId);

      // --- ACTIVITY SETTINGS (per daycare) ---
      // Path: daycares/{daycareId}/activitySettings/config
      match /activitySettings/{docId} {
        allow read: if isAuthenticated() && belongsToDaycare(daycareId);
        allow create, update: if isAuthenticated() && belongsToDaycare(daycareId);
        allow delete: if isAdminOfDaycare(daycareId);
      }
    }

    // ============================================
    // USERS
    // ============================================
    match /users/{userId} {
      // Users can read their own doc.
      // Admin and staff can read other users in their own daycare (staff
      // initials and names are shown against log entries).
      //
      // Parents are deliberately excluded from the second branch. They carry a
      // daycareId like everyone else, so without the role check a parent could
      // list every account in the daycare — staff names and emails, and every
      // other parent. They only ever need their own document.
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        (getUserData().role in ['admin', 'staff']
         && getUserData().daycareId == resource.data.daycareId)
      );

      // Account creation. Each branch below is a specific, authorized path —
      // no branch lets a user pick both their own role AND an existing
      // daycareId, which is what allowed self-promotion to admin previously.
      allow create: if isAuthenticated() && (

        // 1. New daycare owner signing up at /signup.
        //    Allowed to be 'admin', but ONLY with no daycareId. The daycare
        //    link is added later by the update rule below, which requires them
        //    to actually own the daycare they are attaching to.
        (request.auth.uid == userId
         && request.resource.data.role == 'admin'
         && !('daycareId' in request.resource.data))

        // 2. Staff account created by an admin of that same daycare.
        //    The document is written at the new staff member's uid, not the
        //    admin's, so this branch deliberately does not require uid match.
        || (request.resource.data.role == 'staff'
            && isAdminOfDaycare(request.resource.data.daycareId))

        // 3. Parent redeeming an invite. familyId and daycareId must be copied
        //    from the invite rather than supplied freely, and the invite must
        //    still be usable — a revoked invite cannot rebuild access, even
        //    for the account that originally redeemed it.
        || (request.auth.uid == userId
            && request.resource.data.role == 'parent'
            && exists(/databases/$(database)/documents/parentInvites/$(authEmail()))
            && inviteUsable(authEmail())
            && request.resource.data.familyId ==
                 get(/databases/$(database)/documents/parentInvites/$(authEmail())).data.familyId
            && request.resource.data.daycareId ==
                 get(/databases/$(database)/documents/parentInvites/$(authEmail())).data.daycareId)
      );

      // Profile updates. A user may edit their own details but may NOT change
      // their own role, and may only attach themselves to a daycare they
      // created — closing the same escalation path via update instead of create.
      allow update: if isAuthenticated() && (

        (request.auth.uid == userId
         && request.resource.data.role == resource.data.role
         && (
           // daycareId unchanged (ordinary profile edit)
           (('daycareId' in resource.data)
            && ('daycareId' in request.resource.data)
            && request.resource.data.daycareId == resource.data.daycareId)
           // or first-time attach, only to a daycare this user created
           || (!('daycareId' in resource.data)
               && exists(/databases/$(database)/documents/daycares/$(request.resource.data.daycareId))
               && get(/databases/$(database)/documents/daycares/$(request.resource.data.daycareId)).data.createdBy == request.auth.uid)
         ))

        // Admins may manage users already in their own daycare (e.g. removing
        // a staff member by clearing daycareId).
        || (('daycareId' in resource.data) && isAdminOfDaycare(resource.data.daycareId))
      );

      // Only admin can delete staff from their daycare
      allow delete: if isAuthenticated() && isAdminOfDaycare(resource.data.daycareId);
    }

    // ============================================
    // FAMILIES
    // ============================================
    match /families/{familyId} {
      // Authenticated users in the daycare can read
      // Public read also needed for kiosk sign-in (parent info)
      allow read: if true;

      // Staff and admin can create families in their daycare
      allow create: if isAuthenticated() && belongsToDaycare(request.resource.data.daycareId);

      // Staff and admin can update
      allow update: if isAuthenticated() && belongsToDaycare(resource.data.daycareId);

      // Only admin can delete
      allow delete: if isAuthenticated() && isAdminOfDaycare(resource.data.daycareId);
    }

    // ============================================
    // CHILDREN
    // ============================================
    match /children/{childId} {
      // Public read needed for kiosk sign-in (list children)
      // Authenticated daycare staff can also read
      allow read: if true;

      // Staff and admin can create children in their daycare
      allow create: if isAuthenticated() && belongsToDaycare(request.resource.data.daycareId);

      // Staff and admin can update
      allow update: if isAuthenticated() && belongsToDaycare(resource.data.daycareId);

      // Only admin can delete
      allow delete: if isAuthenticated() && isAdminOfDaycare(resource.data.daycareId);

      // --- CARE LOG SETTINGS ---
      // Path: children/{childId}/settings/careLogs
      match /settings/{docId} {
        allow read: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow create, update: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow delete: if isAdminOfDaycare(getChildDaycareId(childId));
      }

      // --- SLEEP LOGS ---
      // Path: children/{childId}/sleepLogs/{dateKey}/entries/{entryId}
      match /sleepLogs/{dateKey}/entries/{entryId} {
        allow read: if (isAuthenticated() && belongsToDaycare(getChildDaycareId(childId)))
                       || isParentOfChild(childId);
        allow create: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow update: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow delete: if isAdminOfDaycare(getChildDaycareId(childId));
      }

      // --- ACTIVE SLEEP ---
      // Path: children/{childId}/activeSleep/current
      match /activeSleep/{docId} {
        allow read, write: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
      }

      // --- CARE LOGS ---
      // Path: children/{childId}/careLogs/{dateKey}/entries/{entryId}
      match /careLogs/{dateKey}/entries/{entryId} {
        allow read: if (isAuthenticated() && belongsToDaycare(getChildDaycareId(childId)))
                       || isParentOfChild(childId);
        allow create: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow update: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow delete: if isAdminOfDaycare(getChildDaycareId(childId));
      }

      // --- ACTIVITY LOGS ---
      // Path: children/{childId}/activityLogs/{dateKey}/entries/{entryId}
      match /activityLogs/{dateKey}/entries/{entryId} {
        allow read: if (isAuthenticated() && belongsToDaycare(getChildDaycareId(childId)))
                       || isParentOfChild(childId);
        allow create: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow update: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow delete: if isAdminOfDaycare(getChildDaycareId(childId));
      }

      // --- INCIDENT LOGS ---
      // Path: children/{childId}/incidentLogs/{dateKey}/entries/{entryId}
      match /incidentLogs/{dateKey}/entries/{entryId} {
        allow read: if (isAuthenticated() && belongsToDaycare(getChildDaycareId(childId)))
                       || isParentOfChild(childId);
        allow create: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow update: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow delete: if isAdminOfDaycare(getChildDaycareId(childId));
      }

      // --- SIGNATURES ---
      // Path: children/{childId}/signatures/{date}
      match /signatures/{date} {
        allow read: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow create, update: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow delete: if isAdminOfDaycare(getChildDaycareId(childId));
      }
    }

    // ============================================
    // SIGN-IN/OUT (Kiosk mode)
    // ============================================
    match /signInOut/{signInOutId} {
      // Public read for kiosk (check sign-in status)
      allow read: if true;

      // Public create for kiosk
      allow create: if true;

      // Immutable — no updates or deletes by anyone
      allow update, delete: if false;
    }

    // ============================================
    // MESSAGE THREADS (Parents Portal Phase 2)
    // ============================================
    // One thread per family; the document ID IS the familyId.
    //
    // That choice is what makes parent access provable for list operations:
    // the messages subcollection can be authorized from the path alone
    // (getUserData().familyId == threadId) with no document read. A rule that
    // had to inspect resource data would be unprovable from query constraints
    // and Firestore would reject the whole query.
    function isParentOfFamily(familyId) {
      return isAuthenticated()
             && getUserData().role == 'parent'
             && getUserData().familyId == familyId;
    }

    match /messageThreads/{threadId} {
      // Staff list threads with where('daycareId','==',...), which makes this
      // provable. Parents read only their own thread, by ID.
      allow read: if isParentOfFamily(threadId)
                     || (resource != null && belongsToDaycare(resource.data.daycareId));

      // Either side may open the thread or update its summary fields.
      allow create: if (isParentOfFamily(threadId)
                        && request.resource.data.familyId == threadId)
                       || belongsToDaycare(request.resource.data.daycareId);

      // Each side owns its own read marker. Without this a parent could stamp
      // lastReadByStaffAt and silently clear the daycare's unread badge — and
      // vice versa.
      allow update: if (isParentOfFamily(threadId)
                        && !request.resource.data.diff(resource.data)
                              .affectedKeys().hasAny(['lastReadByStaffAt']))
                       || (belongsToDaycare(resource.data.daycareId)
                           && !request.resource.data.diff(resource.data)
                                 .affectedKeys().hasAny(['lastReadByParentAt']));

      // Threads are never deleted — message history is a care record.
      allow delete: if false;

      match /messages/{messageId} {
        // threadId == familyId, so no document read is needed here.
        allow read: if isParentOfFamily(threadId)
                       || (isAuthenticated() && getUserData().role in ['admin', 'staff']);

        // Senders cannot forge who they are.
        allow create: if request.resource.data.senderId == request.auth.uid
                         && request.resource.data.familyId == threadId
                         && (
                           (isParentOfFamily(threadId)
                            && request.resource.data.senderRole == 'parent')
                           || (isAuthenticated()
                               && getUserData().role in ['admin', 'staff']
                               && request.resource.data.senderRole == 'staff')
                         );

        // Messages are immutable once sent. Editing history in a care record
        // would undermine it; deletion is admin-only for moderation.
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ============================================
    // PHOTO CONSENT (one per family)
    // ============================================
    // Document ID is the familyId, so rules authorise from the path alone and
    // parent queries stay provable for list operations.
    match /photoConsent/{familyId} {

      // The family that it concerns, and staff in the daycare.
      allow read: if isParentOfFamily(familyId)
                     || (resource != null && belongsToDaycare(resource.data.daycareId));

      // Only a parent of that family may answer, and only in their own name.
      // Staff cannot answer on a family's behalf — a consent record someone
      // else filled in is not a consent record.
      allow create, update: if isParentOfFamily(familyId)
                               && request.resource.data.familyId == familyId
                               && request.resource.data.answeredBy == request.auth.uid
                               && request.resource.data.daycareId == getUserData().daycareId;

      // Never deleted — the record of what was agreed, and when, is the point.
      allow delete: if false;
    }

    // ============================================
    // ANNOUNCEMENTS (daycare-wide)
    // ============================================
    // Scoped by daycareId, including for parents.
    //
    // Read that carefully: everywhere else in this file, authorising a parent
    // by daycareId is the bug that let parents see other families' records.
    // Here it is correct and intentional — an announcement is addressed to
    // every family in the daycare. Nothing family-specific may ever be stored
    // in this collection.
    match /announcements/{announcementId} {

      function announcementData() {
        return get(/databases/$(database)/documents/announcements/$(announcementId)).data;
      }

      // Same daycare, either side. Uses only the path, so it is provable for
      // list operations on the subcollections below.
      function inAnnouncementDaycare() {
        return isAuthenticated() && getUserData().daycareId == announcementData().daycareId;
      }

      allow read: if (resource != null && belongsToDaycare(resource.data.daycareId))
                     || (resource != null
                         && isAuthenticated()
                         && getUserData().role == 'parent'
                         && getUserData().daycareId == resource.data.daycareId);

      // Staff and admin post; authors cannot forge who wrote it.
      allow create: if belongsToDaycare(request.resource.data.daycareId)
                       && request.resource.data.authorId == request.auth.uid;

      allow update: if belongsToDaycare(resource.data.daycareId);
      allow delete: if isAdmin();

      // --- REACTIONS ---
      // Document ID is the reacting user's uid: one reaction each, changeable,
      // removable, and impossible to cast on someone else's behalf.
      match /reactions/{userId} {
        allow read: if inAnnouncementDaycare();

        allow create, update: if inAnnouncementDaycare()
                                 && request.auth.uid == userId
                                 && request.resource.data.emoji in
                                      ['❤️', '😊', '👏', '🎉', '👍'];

        allow delete: if request.auth.uid == userId;
      }

      // --- REPLIES ---
      // Parents may only reply when the post allows it. Staff always may.
      match /replies/{replyId} {
        allow read: if inAnnouncementDaycare();

        allow create: if inAnnouncementDaycare()
                         && request.resource.data.authorId == request.auth.uid
                         && (getUserData().role in ['admin', 'staff']
                             || announcementData().allowReplies == true);

        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ============================================
    // MEDIA (shared photo index)
    // ============================================
    // Flat index so the gallery is one query rather than a walk across
    // messages, activities and incidents.
    match /media/{mediaId} {
      // Parents query with where('familyId','==',...); staff with
      // where('daycareId','==',...). Both are provable.
      allow read: if (resource != null && isParentOfFamily(resource.data.familyId))
                     || (resource != null && belongsToDaycare(resource.data.daycareId));

      allow create: if (isParentOfFamily(request.resource.data.familyId)
                        && request.resource.data.uploadedBy == request.auth.uid
                        && request.resource.data.uploadedByRole == 'parent')
                       || (belongsToDaycare(request.resource.data.daycareId)
                           && request.resource.data.uploadedBy == request.auth.uid
                           && request.resource.data.uploadedByRole == 'staff');

      allow update: if false;
      allow delete: if isAdmin();
    }

    // ============================================
    // PARENT INVITES (Parents Portal)
    // ============================================
    // Document ID is the invited parent's lowercased email address.
    // This document — not the emailed sign-in link — is what authorizes parent
    // access. Anyone can request a magic link for their own address, so the
    // invite is the gate.
    match /parentInvites/{inviteEmail} {
      // 'get' and 'list' are split deliberately.
      //
      // Firestore evaluates list rules against the QUERY, not the documents it
      // returns — if the query's constraints cannot prove every possible match
      // is readable, the whole query is denied. A condition like
      // "authEmail() == inviteEmail" can never be proven from query
      // constraints, so leaving it in the list path denies admin queries even
      // when they would match nothing.
      //
      // get: the invited parent reads their own invite to complete sign-in;
      //      an admin reads any invite in their daycare.
      allow get: if (isAuthenticated() && authEmail() == inviteEmail)
                    || (resource != null && isAdminOfDaycare(resource.data.daycareId));

      // list: admins only, and callers must constrain the query by daycareId
      //       (see ParentAccessSection) so this is provable.
      allow list: if isAdminOfDaycare(resource.data.daycareId);

      // Only an admin of the same daycare may issue an invite, and the document
      // ID must match the email it claims, so it can be found at sign-in.
      allow create: if isAdminOfDaycare(request.resource.data.daycareId)
                       && request.resource.data.status == 'pending'
                       && request.resource.data.email.lower() == inviteEmail;

      // Admins may re-issue. The invited parent may only mark it accepted,
      // and only in their own name — familyId and daycareId cannot be touched.
      allow update: if isAdminOfDaycare(resource.data.daycareId)
                       || (isAuthenticated()
                           && authEmail() == inviteEmail
                           && request.resource.data.diff(resource.data).affectedKeys()
                                .hasOnly(['status', 'acceptedAt', 'acceptedBy'])
                           && request.resource.data.acceptedBy == request.auth.uid);

      allow delete: if isAdminOfDaycare(resource.data.daycareId);
    }

    // ============================================
    // INVITATIONS
    // ============================================
    match /invitations/{invitationId} {
      // Any authenticated user can read (to check their invitation)
      allow read: if isAuthenticated();

      // Only admin can create/manage invitations
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
