rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function belongsToDaycare(daycareId) {
      return isAuthenticated() && getUserData().daycareId == daycareId;
    }

    function isAdminOfDaycare(daycareId) {
      return isAuthenticated() && getUserData().daycareId == daycareId && getUserData().role == 'admin';
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function getChildDaycareId(childId) {
      return get(/databases/$(database)/documents/children/$(childId)).data.daycareId;
    }

    // --- PARENTS PORTAL HELPERS ---

    // The signed-in user's email, lowercased, or '' when absent.
    // Parent invites are keyed by lowercased email.
    function authEmail() {
      return isAuthenticated() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    // True only for a parent whose own familyId matches the child's familyId.
    // This is what scopes a parent to their own children rather than to the
    // whole daycare — parents must never be granted access via daycareId.
    function isParentOfChild(childId) {
      return isAuthenticated() &&
             getUserData().role == 'parent' &&
             getUserData().familyId == get(/databases/$(database)/documents/children/$(childId)).data.familyId;
    }

    // ============================================
    // DAYCARES
    // ============================================
    match /daycares/{daycareId} {
      // Any authenticated user can read (kiosk setup, registration, reports)
      allow read: if isAuthenticated();

      // Only the daycare admin can update
      allow update: if isAdminOfDaycare(daycareId);

      // Authenticated users can create (registration flow)
      allow create: if isAuthenticated();

      // Only admin can delete
      allow delete: if isAdminOfDaycare(daycareId);

      // --- ACTIVITY SETTINGS (per daycare) ---
      // Path: daycares/{daycareId}/activitySettings/config
      match /activitySettings/{docId} {
        allow read: if isAuthenticated() && belongsToDaycare(daycareId);
        allow create, update: if isAuthenticated() && belongsToDaycare(daycareId);
        allow delete: if isAdminOfDaycare(daycareId);
      }
    }

    // ============================================
    // USERS
    // ============================================
    match /users/{userId} {
      // Users can read their own doc
      // Admin can read any user in their daycare
      // Staff can read other users in their daycare (for staff initials/names in logs)
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        getUserData().daycareId == resource.data.daycareId
      );

      // Users can create their own document (registration + staff invite).
      // Staff/admin registration is unchanged. A 'parent' document may only be
      // created when a matching invite exists for the signed-in email address,
      // and familyId/daycareId must be copied from that invite — otherwise any
      // signed-in user could grant themselves access to any family's records.
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        request.resource.data.role in ['admin', 'staff'] ||
        (
          request.resource.data.role == 'parent' &&
          exists(/databases/$(database)/documents/parentInvites/$(authEmail())) &&
          request.resource.data.familyId ==
            get(/databases/$(database)/documents/parentInvites/$(authEmail())).data.familyId &&
          request.resource.data.daycareId ==
            get(/databases/$(database)/documents/parentInvites/$(authEmail())).data.daycareId
        )
      );

      // Users can update their own profile
      // Admin can update staff in their daycare
      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdminOfDaycare(resource.data.daycareId)
      );

      // Only admin can delete staff from their daycare
      allow delete: if isAuthenticated() && isAdminOfDaycare(resource.data.daycareId);
    }

    // ============================================
    // FAMILIES
    // ============================================
    match /families/{familyId} {
      // Authenticated users in the daycare can read
      // Public read also needed for kiosk sign-in (parent info)
      allow read: if true;

      // Staff and admin can create families in their daycare
      allow create: if isAuthenticated() && belongsToDaycare(request.resource.data.daycareId);

      // Staff and admin can update
      allow update: if isAuthenticated() && belongsToDaycare(resource.data.daycareId);

      // Only admin can delete
      allow delete: if isAuthenticated() && isAdminOfDaycare(resource.data.daycareId);
    }

    // ============================================
    // CHILDREN
    // ============================================
    match /children/{childId} {
      // Public read needed for kiosk sign-in (list children)
      // Authenticated daycare staff can also read
      allow read: if true;

      // Staff and admin can create children in their daycare
      allow create: if isAuthenticated() && belongsToDaycare(request.resource.data.daycareId);

      // Staff and admin can update
      allow update: if isAuthenticated() && belongsToDaycare(resource.data.daycareId);

      // Only admin can delete
      allow delete: if isAuthenticated() && isAdminOfDaycare(resource.data.daycareId);

      // --- CARE LOG SETTINGS ---
      // Path: children/{childId}/settings/careLogs
      match /settings/{docId} {
        allow read: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow create, update: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow delete: if isAdminOfDaycare(getChildDaycareId(childId));
      }

      // --- SLEEP LOGS ---
      // Path: children/{childId}/sleepLogs/{dateKey}/entries/{entryId}
      match /sleepLogs/{dateKey}/entries/{entryId} {
        allow read: if (isAuthenticated() && belongsToDaycare(getChildDaycareId(childId)))
                       || isParentOfChild(childId);
        allow create: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow update: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow delete: if isAdminOfDaycare(getChildDaycareId(childId));
      }

      // --- ACTIVE SLEEP ---
      // Path: children/{childId}/activeSleep/current
      match /activeSleep/{docId} {
        allow read, write: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
      }

      // --- CARE LOGS ---
      // Path: children/{childId}/careLogs/{dateKey}/entries/{entryId}
      match /careLogs/{dateKey}/entries/{entryId} {
        allow read: if (isAuthenticated() && belongsToDaycare(getChildDaycareId(childId)))
                       || isParentOfChild(childId);
        allow create: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow update: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow delete: if isAdminOfDaycare(getChildDaycareId(childId));
      }

      // --- ACTIVITY LOGS ---
      // Path: children/{childId}/activityLogs/{dateKey}/entries/{entryId}
      match /activityLogs/{dateKey}/entries/{entryId} {
        allow read: if (isAuthenticated() && belongsToDaycare(getChildDaycareId(childId)))
                       || isParentOfChild(childId);
        allow create: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow update: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow delete: if isAdminOfDaycare(getChildDaycareId(childId));
      }

      // --- INCIDENT LOGS ---
      // Path: children/{childId}/incidentLogs/{dateKey}/entries/{entryId}
      match /incidentLogs/{dateKey}/entries/{entryId} {
        allow read: if (isAuthenticated() && belongsToDaycare(getChildDaycareId(childId)))
                       || isParentOfChild(childId);
        allow create: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow update: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow delete: if isAdminOfDaycare(getChildDaycareId(childId));
      }

      // --- SIGNATURES ---
      // Path: children/{childId}/signatures/{date}
      match /signatures/{date} {
        allow read: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow create, update: if isAuthenticated() && belongsToDaycare(getChildDaycareId(childId));
        allow delete: if isAdminOfDaycare(getChildDaycareId(childId));
      }
    }

    // ============================================
    // SIGN-IN/OUT (Kiosk mode)
    // ============================================
    match /signInOut/{signInOutId} {
      // Public read for kiosk (check sign-in status)
      allow read: if true;

      // Public create for kiosk
      allow create: if true;

      // Immutable — no updates or deletes by anyone
      allow update, delete: if false;
    }

    // ============================================
    // PARENT INVITES (Parents Portal)
    // ============================================
    // Document ID is the invited parent's lowercased email address.
    // This document — not the emailed sign-in link — is what authorizes parent
    // access. Anyone can request a magic link for their own address, so the
    // invite is the gate.
    match /parentInvites/{inviteEmail} {
      // The invited parent reads their own invite to complete sign-in.
      // Admins read invites belonging to their own daycare.
      allow read: if (isAuthenticated() && authEmail() == inviteEmail)
                     || (resource != null && isAdminOfDaycare(resource.data.daycareId));

      // Only an admin of the same daycare may issue an invite, and the document
      // ID must match the email it claims, so it can be found at sign-in.
      allow create: if isAdminOfDaycare(request.resource.data.daycareId)
                       && request.resource.data.status == 'pending'
                       && request.resource.data.email.lower() == inviteEmail;

      // Admins may re-issue. The invited parent may only mark it accepted,
      // and only in their own name — familyId and daycareId cannot be touched.
      allow update: if isAdminOfDaycare(resource.data.daycareId)
                       || (isAuthenticated()
                           && authEmail() == inviteEmail
                           && request.resource.data.diff(resource.data).affectedKeys()
                                .hasOnly(['status', 'acceptedAt', 'acceptedBy'])
                           && request.resource.data.acceptedBy == request.auth.uid);

      allow delete: if isAdminOfDaycare(resource.data.daycareId);
    }

    // ============================================
    // INVITATIONS
    // ============================================
    match /invitations/{invitationId} {
      // Any authenticated user can read (to check their invitation)
      allow read: if isAuthenticated();

      // Only admin can create/manage invitations
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
